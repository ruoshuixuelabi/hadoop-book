<!--
  Maven POM - 第8章：MapReduce类型与格式

  本模块是《Hadoop权威指南》第8章的示例代码，
  演示MapReduce的数据类型和输入输出格式，包括：
  - Mapper和Reducer的泛型类型
  - InputFormat类型（TextInputFormat、KeyValueTextInputFormat等）
  - OutputFormat类型
  - 分区器和排序
  - 多输入/多输出
  - 数据库输入输出

  本模块特点：
  - 依赖common工具类和ch02-mr-intro基础模块
  - 展示各种数据格式的处理方式
  - 提供完整的数据流示例
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- 继承hadoop-meta父POM，获取统一的依赖版本管理 -->
  <parent>
    <groupId>com.hadoopbook</groupId>
    <artifactId>hadoop-meta</artifactId>
    <version>4.0</version>
    <relativePath>../hadoop-meta/pom.xml</relativePath>
  </parent>

  <groupId>com.hadoopbook</groupId>
  <artifactId>ch08-mr-types</artifactId>
  <packaging>jar</packaging>
  <version>4.0</version>

  <!-- 章节名称：MapReduce类型与格式 -->
  <name>Chapter 8: MapReduce Types and Formats</name>

  <!-- ==================== 依赖项配置 ==================== -->
  <dependencies>
    <!--
      common模块：包含共享的工具类
      如NcdcRecordParser等数据解析工具
    -->
    <dependency>
      <groupId>com.hadoopbook</groupId>
      <artifactId>common</artifactId>
      <version>4.0</version>
    </dependency>

    <!--
      ch02-mr-intro模块：提供基础的MapReduce实现
      用于演示类型与格式的使用
    -->
    <dependency>
      <groupId>com.hadoopbook</groupId>
      <artifactId>ch02-mr-intro</artifactId>
      <version>4.0</version>
    </dependency>

    <!-- JUnit测试框架：用于编写和运行单元测试 -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>