<!--
  本项目是《Hadoop: The Definitive Guide》第四版第15章的示例代码
  演示了如何使用Sqoop从关系型数据库导入数据到HDFS，以及如何处理导入的数据

  Sqoop是Apache基金会的一个工具，用于在Hadoop和关系型数据库之间高效传输数据
  本模块展示了两种处理导入数据的方式：
  1. 使用Sqoop生成的Record类（MaxWidgetId.java）
  2. 使用Generic Avro API直接处理Avro格式数据（MaxWidgetIdGenericAvro.java）
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <!--
        继承自hadoop-meta父POM，该父POM定义了所有组件的版本管理
        包括Hadoop、Sqoop、Avro等依赖的版本号
    -->
    <parent>
        <groupId>com.hadoopbook</groupId>
        <artifactId>hadoop-meta</artifactId>
        <version>4.0</version>
        <relativePath>../hadoop-meta/pom.xml</relativePath>
    </parent>
    <groupId>com.hadoopbook</groupId>
    <artifactId>ch15-sqoop</artifactId>
    <packaging>jar</packaging>
    <version>4.0</version>
    <!-- 章节名称：Sqoop - 数据导入工具 -->
    <name>Chapter 15: Sqoop</name>

    <dependencies>
        <!--
            Sqoop依赖 - 用于将关系型数据库的数据导入到HDFS
            classifier设置为hadoop200表示兼容Hadoop 2.x版本
            Sqoop生成的代码会继承SqoopRecord接口，实现DBWritable和Writable接口
        -->
        <dependency>
            <groupId>org.apache.sqoop</groupId>
            <artifactId>sqoop</artifactId>
            <classifier>hadoop200</classifier>
        </dependency>
        <!--
            Avro依赖 - 一种跨语言的数据序列化系统
            用于处理Sqoop导入的Avro格式数据
        -->
        <dependency>
            <groupId>org.apache.avro</groupId>
            <artifactId>avro</artifactId>
        </dependency>
        <!--
            Avro MapReduce绑定 - 允许在Hadoop MapReduce作业中使用Avro数据
            注意：hadoop2分类器被注释掉了，默认使用不带分类器的版本
        -->
        <dependency>
            <groupId>org.apache.avro</groupId>
            <artifactId>avro-mapred</artifactId>
<!--            <classifier>hadoop2</classifier>-->
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <!--
                    Maven Assembly插件 - 用于打包本模块的所有依赖和类
                    配置说明：
                    - descriptor指向父模块的jar.xml描述符文件
                    - finalName设置打包后的JAR名称为sqoop-examples
                    - outputDirectory将输出目录设置为项目根目录的target目录
                    - appendAssemblyId=false表示不追加assembly ID到文件名
                -->
                <artifactId>maven-assembly-plugin</artifactId>
                <configuration>
                    <descriptors>
                        <descriptor>../book/src/main/assembly/jar.xml</descriptor>
                    </descriptors>
                    <finalName>sqoop-examples</finalName>
                    <outputDirectory>${project.build.directory}/../..</outputDirectory>
                    <appendAssemblyId>false</appendAssemblyId>
                </configuration>
                <executions>
                    <!--
                        在package阶段执行单次打包
                        这确保了每次运行mvn package时会生成可执行的JAR文件
                    -->
                    <execution>
                        <id>make-assembly</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
