<!--
  Wikipedia XML 转储样本文件 (完整版)
  ===================================

  此文件采用 MediaWiki XML Export 0.3 格式,是 Wikipedia 公开数据转储的标准格式。
  可从 https://dumps.wikimedia.org/ 下载完整的 Wikipedia 转储文件。

  此文件与 example.xml 的区别:
  - 使用正式的命名空间声明 (xmlns)
  - 包含 <siteinfo> 元数据区块
  - 每个页面和版本都有唯一 ID
  - 贡献者信息更完整 (包含用户 ID)
-->
<mediawiki xmlns="http://www.mediawiki.org/xml/export-0.3/"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://www.mediawiki.org/xml/export-0.3/ http://www.mediawiki.org/xml/export-0.3.xsd"
           version="0.3"
           xml:lang="en">

  <!--
    <siteinfo>: 站点信息元数据
    描述导出此数据时的 Wikipedia 站点配置信息
  -->
  <siteinfo>
    <!-- <sitename>: 站点名称 -->
    <sitename>Wikipedia</sitename>

    <!-- <base>: 网站首页 URL -->
    <base>http://en.wikipedia.org/wiki/Main_Page</base>

    <!-- <generator>: 导出时使用的 MediaWiki 版本 -->
    <generator>MediaWiki 1.14alpha</generator>

    <!-- <case>: 标题大小写处理方式 (first-letter=首字母大写) -->
    <case>first-letter</case>

    <!--
      <namespaces>: 命名空间定义
      命名空间用于区分不同类型的页面,如文章、用户页、讨论页等
      key="-2": Media (媒体文件)
      key="-1": Special (特殊页面)
      key="0": 主命名空间 (文章)
      key="1": Talk (讨论)
      key="2": User (用户)
      key="3": User talk (用户讨论)
      key="4": Wikipedia (项目页面)
      key="5": Wikipedia talk (项目讨论)
      key="6": Image (图像)
      key="7": Image talk (图像讨论)
      key="8": MediaWiki (系统消息)
      key="9": MediaWiki talk (系统消息讨论)
      key="10": Template (模板)
      key="11": Template talk (模板讨论)
      key="12": Help (帮助)
      key="13": Help talk (帮助讨论)
      key="14": Category (分类)
      key="15": Category talk (分类讨论)
      key="100": Portal (主题页面)
      key="101": Portal talk (主题讨论)
    -->
    <namespaces>
      <namespace key="-2">Media</namespace>
      <namespace key="-1">Special</namespace>
      <namespace key="0" />
      <namespace key="1">Talk</namespace>
      <namespace key="2">User</namespace>
      <namespace key="3">User talk</namespace>
      <namespace key="4">Wikipedia</namespace>
      <namespace key="5">Wikipedia talk</namespace>
      <namespace key="6">Image</namespace>
      <namespace key="7">Image talk</namespace>
      <namespace key="8">MediaWiki</namespace>
      <namespace key="9">MediaWiki talk</namespace>
      <namespace key="10">Template</namespace>
      <namespace key="11">Template talk</namespace>
      <namespace key="12">Help</namespace>
      <namespace key="13">Help talk</namespace>
      <namespace key="14">Category</namespace>
      <namespace key="15">Category talk</namespace>
      <namespace key="100">Portal</namespace>
      <namespace key="101">Portal talk</namespace>
    </namespaces>
  </siteinfo>

  <!--
    ========================================
    页面条目示例
    ========================================
    每个 <page> 代表一篇 Wikipedia 文章
    包含: 标题(title)、页面ID(id)、当前版本(revision)
  -->
  <page>
    <!-- <title>: 文章标题 (这里是重定向页面) -->
    <title>AmericanSamoa</title>

    <!-- <id>: 页面唯一标识符,用于 Wikipedia 内部引用 -->
    <id>6</id>

    <!--
      <revision>: 版本记录
      包含: 版本ID、时间戳、贡献者、是否小编辑、编辑摘要、页面内容
    -->
    <revision>
      <!-- <id>: 此版本的唯一标识符 -->
      <id>133452270</id>

      <!-- <timestamp>: 编辑时间,ISO 8601 格式 -->
      <timestamp>2007-05-25T17:12:06Z</timestamp>

      <!--
        <contributor>: 贡献者信息
        包含 <username> (用户名) 和 <id> (用户ID)
      -->
      <contributor>
        <username>Gurch</username>
        <id>241822</id>
      </contributor>

      <!-- <minor />: 小编辑标记 -->
      <minor />

      <!-- <comment>: 编辑摘要,描述本次修改 -->
      <comment>Revert edit(s) by [[Special:Contributions/Ngaiklin|Ngaiklin]] to last version by [[Special:Contributions/Docu|Docu]]</comment>

      <!--
        <text>: 页面内容
        #REDIRECT 表示这是重定向页面
        {{R from CamelCase}} 是重定向模板,表示从驼峰命名重定向
        xml:space="preserve" 保留空白字符
      -->
      <text xml:space="preserve">#REDIRECT [[American Samoa]]{{R from CamelCase}}</text>
    </revision>
  </page>

