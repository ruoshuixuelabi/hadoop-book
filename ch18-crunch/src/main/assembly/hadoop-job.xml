<?xml version="1.0" encoding="UTF-8"?>

<!-- 这是 Maven 装配插件（assembly plugin）的描述文件：把本章的类和它的运行时依赖打成一个可以直接用 hadoop jar 提交的作业包。 -->
<!-- 关键在于作业包内部的目录结构：hadoop jar 会把包解开到临时目录，再把 lib 目录下的每个 jar 都加进类路径，而作业自己的类要摊在包根目录。 -->
<!-- 所以下面把依赖和本章自己的构件分成了两个依赖集，分别放到 lib 和根目录。 -->
<assembly xmlns="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.0 http://maven.apache.org/xsd/assembly-1.1.0.xsd">

  <!-- 装配的标识决定了产物的名字：最终打出来的是 ch18-crunch-4.0-job.jar -->
  <id>job</id>
  <formats>
    <!-- 只能是 jar：hadoop jar 命令只认 jar 格式的作业包 -->
    <format>jar</format>
  </formats>
  <!-- 不要在包里再套一层最外层目录：Hadoop 解开作业包后是按根目录去找类和依赖的 -->
  <includeBaseDirectory>false</includeBaseDirectory>
  <dependencySets>
    <!-- 第一组依赖：把运行期需要的第三方库原封不动地放进 lib 目录 -->
    <dependencySet>
      <!-- 不解压：第三方库保持各自的 jar 形态，Hadoop 才会把 lib 下每个文件都当成一个 jar 加进类路径 -->
      <unpack>false</unpack>
      <!-- 只收编译期和运行期的依赖：测试期才用到的库（crunch-test、junit）没必要跟着作业走 -->
      <scope>runtime</scope>
      <!-- 输出到 lib 目录，这正是 Hadoop 作业包约定的第三方依赖位置 -->
      <outputDirectory>lib</outputDirectory>
      <excludes>
        <!-- 把本章自己的构件排除掉：它由下面第二组依赖负责，否则会在 lib 里多出一份重复的 jar -->
        <exclude>${groupId}:${artifactId}</exclude>
      </excludes>
    </dependencySet>
    <!-- 第二组依赖：只处理本章自己的构件 -->
    <dependencySet>
      <!-- 解压：把本章的类摊在作业包根目录，作业的入口类才好被 hadoop jar 按名字找到 -->
      <unpack>true</unpack>
      <includes>
        <include>${groupId}:${artifactId}</include>
      </includes>
    </dependencySet>
  </dependencySets>
</assembly>
