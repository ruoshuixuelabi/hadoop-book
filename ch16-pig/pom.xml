<!-- ch16-pig模块的Maven POM配置文件 -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <!-- 继承父模块hadoop-meta,获取统一的依赖版本管理 -->
    <parent>
        <groupId>com.hadoopbook</groupId>
        <artifactId>hadoop-meta</artifactId>
        <version>4.0</version>
        <relativePath>../hadoop-meta/pom.xml</relativePath>
    </parent>
    <groupId>com.hadoopbook</groupId>
    <artifactId>ch16-pig</artifactId>
    <packaging>jar</packaging>
    <version>4.0</version>
    <name>Chapter 16: Pig</name>
    <!-- 项目依赖 -->
    <dependencies>
        <!-- Apache Pig: 数据流脚本语言,用于处理大规模数据集 -->
        <dependency>
            <groupId>org.apache.pig</groupId>
            <artifactId>pig</artifactId>
        </dependency>
        <!-- JUnit: Java单元测试框架 -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
        </dependency>
    </dependencies>
    <!-- 构建配置 -->
    <build>
        <plugins>
            <plugin>
                <!-- Maven Assembly插件: 用于打包所有示例代码为一个可执行JAR -->
                <artifactId>maven-assembly-plugin</artifactId>
                <configuration>
                    <!-- 使用预定义的assembly描述符 -->
                    <descriptors>
                        <descriptor>../book/src/main/assembly/jar.xml</descriptor>
                    </descriptors>
                    <!-- 打包后的JAR名称 -->
                    <finalName>pig-examples</finalName>
                    <!-- 输出到项目根目录的target文件夹 -->
                    <outputDirectory>${project.build.directory}/../..</outputDirectory>
                    <!-- 不在JAR名称后追加assembly ID -->
                    <appendAssemblyId>false</appendAssemblyId>
                </configuration>
                <executions>
                    <execution>
                        <id>make-assembly</id>
                        <!-- 在package阶段执行打包 -->
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>