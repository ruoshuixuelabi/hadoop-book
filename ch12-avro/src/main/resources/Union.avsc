[
  // 这是一份「联合类型」模式：值可以是列出的任意一种类型。
  // 联合类型在 JSON 里直接写成一个数组，不必有外层的 type。
  // 编码时 Avro 会先写一个 int 说明实际用的是第几个分支（从 0 开始），
  // 再按该分支的类型写值；解码时靠这个编号选出分支来解析。
  "null",
  // 第一个分支是 null。
  "string",
  // 第二个分支是字符串。
  {"type": "map", "values": "string"}
  // 第三个分支本身是一份完整模式（map），
  // 说明联合的分支不但可以是简单类型，也可以是嵌套的复杂类型。
]